---
layout: page
---
{%- comment -%} Build a Jekyll-paginate-compatible paginator from 11ty pagination. {%- endcomment -%}
{% assign cur = pagination.pageNumber | plus: 1 %}
{% assign total = pagination.pages.size %}

{% if pagination.pageNumber == 0 %}{{ content }}{% endif %}
<div id="post-list">
  {% for post in postlist %}
  <div class="post-preview">
    <h1><a href="{{ post.url | relative_url }}">{{ post.data.title }}</a></h1>
    <div class="post-content">
      <p>{{ post.templateContent | strip_html | truncate: 200 }}</p>
    </div>
    <div class="post-meta text-muted d-flex justify-content-between">
      <div>
        {% unless post.data.dateUnknown %}
        <i class="far fa-calendar fa-fw"></i>
        {{ post.date | postDate }}
        {% endunless %}
      </div>
      {% if post.data.categories.size > 0 %}
      <div class="post-meta mb-3">
        <i class="far fa-folder-open fa-fw mr-1"></i>
        {% for category in post.data.categories %}<a href="{{ site.baseurl }}/{{ category | slugify | url_encode }}">{{ category }}</a>{% unless forloop.last %}, {% endunless %}{% endfor %}
      </div>
      {% endif %}
    </div>
  </div>
  {% endfor %}
</div>
{% if total > 0 %}
<ul class="pagination mt-4 mb-0 pl-lg-2">
  <li class="page-item {% unless pagination.href.previous %}disabled{% endunless %}">
    <a class="page-link btn-box-shadow" href="{{ pagination.href.previous | default: '#' }}" aria-label="previous-page"><i class="fas fa-angle-left"></i></a>
  </li>
  {% assign left_ellipsis = false %}
  {% assign right_ellipsis = false %}
  {% for i in (1..total) %}
    {% assign pre = cur | minus: 1 %}
    {% assign next = cur | plus: 1 %}
    {% assign pre_less = pre | minus: 1 %}
    {% assign show = false %}
    {% if cur == 1 %}
      {% if i <= 3 or i == total %}{% assign show = true %}{% endif %}
    {% elsif cur == total %}
      {% if i == 1 or i >= pre_less %}{% assign show = true %}{% endif %}
    {% else %}
      {% if i == 1 or i == total %}{% assign show = true %}{% elsif i >= pre and i <= next %}{% assign show = true %}{% endif %}
    {% endif %}
    {% if show %}
      <li class="page-item{% if i == cur %} active{% endif %}">
        <a class="page-link btn-box-shadow" href="{{ site.baseurl }}/{% if i > 1 %}page{{ i }}/{% endif %}">{{ i }}</a>
      </li>
    {% else %}
      {% if i < pre and left_ellipsis == false %}
        <li class="page-item disabled"><span class="page-link btn-box-shadow">...</span></li>
        {% assign left_ellipsis = true %}
      {% elsif i > next and right_ellipsis == false %}
        <li class="page-item disabled"><span class="page-link btn-box-shadow">...</span></li>
        {% assign right_ellipsis = true %}
      {% endif %}
    {% endif %}
  {% endfor %}
  <li class="page-item {% unless pagination.href.next %}disabled{% endunless %}">
    <a class="page-link btn-box-shadow" href="{{ pagination.href.next | default: '#' }}" aria-label="next-page"><i class="fas fa-angle-right"></i></a>
  </li>
</ul>
{% endif %}
