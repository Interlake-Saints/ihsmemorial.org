<!DOCTYPE html>
<html lang="{{ site.lang | default: 'en-US' }}" mode="dark">
{% include "head.liquid" %}
<body data-spy="scroll" data-target="#toc">
  {% include "sidebar.liquid" %}
  {% include "topbar.liquid" %}
  <div id="main-wrapper">
    <div id="main">
      {{ content }}
      {% include "footer.liquid" %}
    </div>
    {% include "search-results.liquid" %}
  </div>
  <div id="mask"></div>
  <a id="back-to-top" href="#" aria-label="back-to-top" class="btn btn-lg btn-box-shadow" role="button">
    <i class="fas fa-angle-up"></i>
  </a>
  {% include "search-loader.liquid" %}
</body>
</html>
