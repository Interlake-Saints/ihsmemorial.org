---
layout: page
---
<div id="archives" class="pl-xl-2">
{% assign posts = collections.postsByDate %}
{% assign last_year = "" %}
{% for post in posts %}
  {% assign this_year = post.date | date: "%Y" %}
  {% if this_year != last_year %}
    {% unless forloop.first %}</ul>{% endunless %}
    <span class="lead">{{ this_year }}</span>
    <ul class="list-unstyled">
    {% assign last_year = this_year %}
  {% endif %}
    <li>
      <div>
        <span class="date day">{{ post.date | date: "%d" }}</span>
        <span class="date month small text-muted">{{ post.date | date: "%b" }}</span>
        <a href="{{ post.url | relative_url }}">{{ post.data.title }}</a>
      </div>
    </li>
  {% if forloop.last %}</ul>{% endif %}
{% endfor %}
</div>
