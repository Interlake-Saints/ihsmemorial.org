---
layout: base
---
<div class="post pl-1 pr-1 pl-sm-2 pr-sm-2 pl-md-4 pr-md-4">
  <h1 data-toc-skip>{{ title }}</h1>
  <div class="post-meta text-muted d-flex flex-column">
    <div>
      {% unless dateUnknown %}{{ date | postDate }}{% endunless %} by
      <span class="author">{{ author | default: site.author }}</span>
    </div>
  </div>
  <div class="post-content">
    {{ content }}
    {% if obituary %}
      {% assign pronoun = 'Their' %}
      {% if gender == 'male' %}{% assign pronoun = 'His' %}{% elsif gender == 'female' %}{% assign pronoun = 'Her' %}{% endif %}
      <p>
        {{ pronoun }} obituary can be found
        <a href="{{ obituary }}" target="_blank" rel="noopener">here</a>.
      </p>
    {% endif %}
    {% for image in images %}
      <div class="text-center">
        <img src="{{ image }}" class="rounded" alt="{{ title | escape }}" loading="lazy" style="max-height: 350px; width: auto" />
      </div>
    {% endfor %}
  </div>
  <div class="post-tail-wrapper text-muted">
    {% if categories.size > 0 %}
    <div class="post-meta mb-3">
      <i class="far fa-folder-open fa-fw mr-1"></i>
      {% for category in categories %}<a href="{{ site.baseurl }}/{{ category | slugify | url_encode }}">{{ category }}</a>{% unless forloop.last %}, {% endunless %}{% endfor %}
    </div>
    {% endif %}
    {% if tags.size > 0 %}
    <div class="post-tags">
      <i class="fa fa-tags fa-fw mr-1"></i>
      {% for tag in tags %}<a href="{{ site.baseurl }}/cause/{{ tag | slugify | url_encode }}" class="post-tag no-text-decoration">{{ tag }}</a>{% endfor %}
    </div>
    {% endif %}
  </div>
</div>
